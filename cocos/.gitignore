# ===== Cocos Creator 生成/缓存目录（不要入库）=====
/library/        # 资源数据库缓存，编辑器首次打开工程时生成
/temp/           # 临时构建产物（含 temp/tsconfig.cocos.json —— 根 tsconfig 的 extends 基座）
/local/          # 本地设置（每台机器不同）
/build/          # 构建输出
/profiles/       # 编辑器窗口布局等本地 profile
/native/         # 原生工程输出

# ⚠️ 注意：**不要**忽略 /.creator/
#    里面的 default-meta.json 是「工程配置」（图片默认按 sprite-frame 导入），
#    官方 empty-2d 模板就是把它入库的。忽略了它 → 换台机器打开，图片导入类型就变了。

# ===== 系统/编辑器垃圾 =====
.DS_Store
*.log
Thumbs.db
.vscode/
.idea/

# ===== 依赖（Cocos 引擎由编辑器解析，不提交 node_modules）=====
node_modules/
