# 依赖与构建产物
node_modules/
web/node_modules/
web/dist/

# 运行时数据（云存档/排行榜，本地生成，不入库）
data/
server/data/

# 立绘原图备份（AI 原始 1024 图，仓库只保留处理后的 256 透明版）
web/src/assets/portraits_raw/
tools/directional_raw/

# 编译产物
*.exe
bin/
server/server

# 日志
*.log

# 临时诊断产物（截图放大、体检裁剪等，随时可重新生成）
_diag/
docs/_baseline/
docs/_old-preview/
docs/_*.png

# 无头浏览器调试用的临时 profile
**/cdp-prof*/

# 系统文件
.DS_Store
Thumbs.db

# Python 缓存
__pycache__/
*.pyc

# 无头验证截图产物（随时可重新生成）
tools/shots/

# 无头验证用的临时编译产物（tsc --outDir .tmp/，随时可重新生成）
.tmp/

# AI 生图候选原图（1024 级原始产出，体积大且不入库；仓库只保留处理后的成品）
web/src/assets/env_candidates/
web/src/assets/fish_candidates/
web/src/assets/sub_candidates/
web/src/assets/wpn_candidates/
web/src/assets/weapons_candidates/
# AI 生成的原始打光图（1024×1024，约 3MB）+ 处理中间件 + 旧版归档。
# 与 portraits_raw/ 同一约定：源图不入库，仓库只留 clean_* 处理结果。
web/src/assets/fish/_regen/
# 潜航器三台的 AI 生成源图（1024×1024 棋盘格底，约 3MB/张）+ 处理中间件。
# 与 fish/_regen/ 同一约定：源图不入库，仓库只留 clean 后的 sub_*.png。
web/src/assets/sub/_regen_v2/
# 道具卡立绘的 AI 生成源图（1024 级原始产出，约 1.5MB/张）。
# 与 fish/_regen/、sub/_regen_v2/ 同一约定：源图不入库，只留处理后的 item_*.png。
# 注：本目录早期已有部分文件被误入库（见提交说明），此处仅阻止继续增长。
web/src/assets/items/_regen/

# ImageGen 工具的默认输出目录（AI 源图，与上面 *_regen/ 同一约定：源图不入库）。
# 正式归档的出图原稿走 docs/shots/sub_art/01_出图原稿/，那份入库。
generated-images/

# WorkBuddy 会话产出图（诊断图 _diag_*/iso*/turret_*、设计对照图）；
# 可随时重新生成，且体积大。仓库只留 overview.md 与 memory。
.workbuddy/artifacts/*.png

# WorkBuddy 会话临时产物（env 打样/对比的中间图，可达数十 MB，随时可重新生成）
.workbuddy/tmp/
