# 依赖与构建产物
node_modules/
web/node_modules/
web/dist/

# 运行时数据（云存档/排行榜，本地生成，不入库）
data/
server/data/

# 立绘原图备份（AI 原始 1024 图，仓库只保留处理后的 256 透明版）
web/src/assets/portraits_raw/
tools/directional_raw/

# 编译产物
*.exe
bin/
server/server

# 日志
*.log

# 临时诊断产物（截图放大、体检裁剪等，随时可重新生成）
_diag/
docs/_baseline/
docs/_old-preview/
docs/_*.png

# 无头浏览器调试用的临时 profile
**/cdp-prof*/

# 系统文件
.DS_Store
Thumbs.db

# Python 缓存
__pycache__/
*.pyc

# 无头验证截图产物（随时可重新生成）
tools/shots/
